integer a = 10;
integer b = 3;
display("a + b ="); display(a + b);
display("a - b ="); display(a - b);
display("a * b ="); display(a * b);
display("a / b ="); display(a / b);
display("a % b ="); display(a % b);
display("a ^ b ="); display(a ^ b);

boolean x = true;
boolean y = false;
display("x AND y ="); display(x AND y);
display("x OR y ="); display(x OR y);
display("NOT x ="); display(NOT x);

display("10 > 5 is"); display(10 > 5);
display("10 == 10 is"); display(10 == 10);
display("10 != 5 is"); display(10 != 5);