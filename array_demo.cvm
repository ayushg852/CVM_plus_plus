/* Array Operations Demo */

displayln("--- Array Literal ---");
array arr = [10, 20, 30, 40, 50];
display("Initial array: ");
displayln(arr);

displayln("--- Indexing (Read/Write) ---");
display("Element at index 2: ");
displayln(arr[2]);

arr[2] = 99;
display("After arr[2] = 99: ");
displayln(arr);

displayln("--- Size Function ---");
display("Array size: ");
displayln(size(arr));

displayln("--- Dynamic Array Creation ---");
displayln("Enter size for new array:");
integer n = enter();
array dynamicArr = array(n);
for ( integer i from 0 to n-1){
    dynamicArr[i] = enter();
}
display("Created array of size ");
display(n);
display(": ");
displayln(dynamicArr);

displayln("--- Mixed Type Array ---");
array mixed = [1, 2.5, "hello", true];
displayln(mixed);